# PRNT Environment Variables
# Copy this file to .env and fill in your values
# These are configured in Cloudflare Dashboard → Pages → Settings → Environment variables

# ===========================================
# REQUIRED
# ===========================================

# D1 Database (automatically bound via wrangler.toml)
# DB binding is configured in wrangler.toml, no env var needed

# ===========================================
# OPTIONAL - Google Integration
# ===========================================

# Google OAuth credentials (for Calendar/Tasks sync)
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ===========================================
# OPTIONAL - External Integrations
# ===========================================

# API key for external integrations (Raycast, iOS Shortcuts, Email Worker)
# Generate with: openssl rand -hex 32
PRNT_API_KEY=your-secure-api-key-here

# ===========================================
# OPTIONAL - AI Features
# ===========================================

# Anthropic API key for AI-powered weekly summaries
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
